    "security-guidance@claude-plugins-official": true,
    "financial-analysis@claude-for-financial-services": false,
    "agent-skills@addy-agent-skills": false,
    "ecc@ecc": false,
    "mattpocock-skills@mattpocock": true,
    "obsidian@obsidian-skills": true,
